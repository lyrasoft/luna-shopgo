    "extends": [
        "@windwalker-io/unicorn-next/tsconfig.js.json"
    ],
    "include": [
        "src/**/*.ts",
        "src/**/*.vue"
    ],
    "exclude": [
        "node_modules/**/*"
    ],
    "types": [
        "reflect-metadata"
    ],
    "compilerOptions": {
        "types": [
            "vue"
        ],
        "paths": {
            "~shopgo/*": [
                "./src/*"
            ]
        }
    }
}
